# AI Support SOC — configuration template.
#   cp .env.example .env      then fill in the empty values
#
# .env is git-ignored and this repository has a PUBLIC GitHub remote: this file
# carries no real secret and must never carry one.
#
# Everything down to the last block is context pack §6.3, in §6.3's order and
# grouping, with the documented default as the value; secrets are left empty.
# §6.3 is a frozen contract — a new key needs a DECISION_REQUEST in
# docs/plan/INBOX.md, never an edit here.

# --- database · §6.3 since DEC-003 -----------------------------------------
# The application connects as app_rw — a LOGIN role over TCP + scram-sha-256,
# made loginable once per cluster by a superuser (HUONG-DAN §0, DEC-023) —
# and migrations run as the owner role over the passwordless socket (§6.1);
# the grants land with P1 migration 017. The test database name
# must end in _test — backend/tests/conftest.py refuses anything else, so a
# test run can never be pointed at the real database by accident.
# PostgreSQL runs natively on this host and no target needs docker (Owner
# decision, 05/09). These socket DSNs are passwordless: pg_hba gives
# `local all all peer`, while `host 127.0.0.1/32` is scram-sha-256, so a TCP
# form would prompt for a password.
# --- BEGIN generated from context pack §6.3 — edit §6.3, then run scripts/gen_env_example.py
#     Do not add or rename a key here — §6.3 is a frozen contract (DEC-003).
DATABASE_URL=postgresql://app_rw:@127.0.0.1:5432/soc_dev   # app runtime as app_rw (LOGIN, DEC-023); its password goes after the colon, in .env only
DATABASE_URL_OWNER=postgresql:///soc_dev        # migrations and test setup, owner role (user1 owns soc_dev)
TEST_DATABASE_URL=postgresql:///soc_test        # tests only; the database name must end in _test
MAX_PAYLOAD_BYTES=2_097_152
RAW_LOG_MAX_BYTES=1_024_000
PROMPT_LOG_MAX_BYTES=32_768
DEDUP_IDLE_GAP_MINUTES=15
MAX_CLUSTER_AGE_HOURS=4
MAX_CLUSTER_AGE_AUTOCLOSED_MINUTES=30
MAX_CLUSTER_SIZE=1000
DEDUP_ENABLED=true                              # DEC-165: false = every alert is its own queue row and triage job; forward-only (docs/runbook.md, Grouping switch)
PULL_ENABLED=true                               # DEC-207: false = no pull job is seeded and a pending one is not re-armed; alerts arrive by the webhook only (docs/runbook.md, SOAR intake)
AUTOCLOSE_ENABLED=true                          # DEC-207: false = no auto-close rule is loaded or evaluated; every non-duplicate alert is queued for Tier 1 (docs/runbook.md, SOAR intake)
ENRICHMENT_ENABLED=true                         # DEC-207: false = no assets/identities/iocs lookup; the context comes from the payload's enrichment (DEC-208), else the unknown context (docs/runbook.md, SOAR intake)
PROMPT_INCLUDE_SIEM_CONTEXT=true                # S2: false = the ① prompt leaves SOAR's enrichment out (no siem_context block); the facts, the gate and the verifier never read it (docs/runbook.md)
PROMPT_INCLUDE_MITRE_REFERENCE=false            # DEC-223: true = the ① prompt carries MITRE's own text, from the local ATT&CK extract kb/mitre/, for the alert's technique ids (block mitre_reference, at most 6 entries); false = every prompt is what it was; the facts, the gate and the verifier never read it (docs/runbook.md)
INDEXER_URL=https://127.0.0.1:9400
INDEXER_USER=
INDEXER_PASSWORD=
INDEXER_CA=conf/root-ca.pem
INDEXER_INDEX=wazuh-alerts-*
PULL_INTERVAL_S=60
PULL_OVERLAP_S=60
PULL_PAGE=500
PULL_START=2026-08-01
HEARTBEAT_RULE_ID=100999
HEARTBEAT_MAX_AGE_MIN=30
SILENCE_WARN_HOURS=3
WEBHOOK_SOURCE_MAX_AGE_H=24
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF=[10,60,300]
JOB_LOCK_TIMEOUT_S=300
N_WORKER=1
INVENTORY_PATHS=["conf/inventory.yaml","conf/identities.yaml","conf/iocs.csv"]
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=
LLM_MODEL_PROPOSER=deepseek-v4-flash
LLM_MODEL_VERIFIER=
LLM_TIMEOUT_S=120
LLM_RETRY=2
LLM_THINKING=disabled
LLM_RESPONSE_FORMAT=json_object
LLM_MONTHLY_USD_CAP=30
LLM_PRICE_IN_PER_M=0.014
LLM_PRICE_OUT_PER_M=0.66
PROMPT_TOTAL_BUDGET_TOKENS=40_000
CASE_PROMPT_BUDGET_TOKENS=60_000
ANALYZE_QUOTA_PER_USER_DAY=30
NEVER_AUTOCLOSE_AGENTS=[]
AUTOCLOSE_RULE_WIDTH_PCT=30
REVIEW_DELTA_TOLERANCE=20
MAX_ALERTS_PER_CASE=200
JWT_SECRET=
JWT_TTL_HOURS=8
LOGIN_MAX_FAILS=5
LOCKOUT_MINUTES=15
WEBHOOK_API_KEY=
WEBHOOK_IP_ALLOWLIST=
RETENTION_DAYS=365
BACKUP_HOUR=2
EVAL_BLIND_FRACTION=0.5
DISPLAY_TZ=Asia/Ho_Chi_Minh
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
RAG_ENABLED=false                               # DEC-210: true = a lookup of approved knowledge and decision history is made for each alert and case, and ①/② prompts carry it; false = nothing is enqueued and the prompts are byte-identical (docs/runbook.md, Environment keys)
KNOWLEDGE_DRAFT_ENABLED=false                   # DEC-210: true = a draft knowledge entry is proposed on each conclusion, for an admin to review; false = none is enqueued
RAG_MODEL=                                      # DEC-210: the model of the knowledge-draft calls (the lookup calls no model, DEC-213); empty means LLM_MODEL_PROPOSER
RAG_TRIAGE_DELAY_S=45                           # DEC-210: how long a triage waits for its lookup (seconds)
RAG_CASE_REFRESH_H=24                           # DEC-210: a case's lookup is made again when older than this (hours)
RAG_HISTORY_DAYS=90                             # DEC-210: how far back the decision history looks (days)
RAG_MONTHLY_USD_CAP=3                           # DEC-210: the lookup's own monthly spend cap, counted inside LLM_MONTHLY_USD_CAP
KNOWLEDGE_QUEUE_MAX=200                         # DEC-210: the number of pending drafts above which the knowledge_queue health check alarms
VOYAGE_API_KEY=                                 # DEC-213: the Voyage account's key, a secret, .env only; with RAG_ENABLED on, empty = the lookup fails with failure_kind auth and no request is sent (docs/runbook.md, Voyage vector RAG (DEC-213))
VOYAGE_BASE_URL=https://api.voyageai.com/v1       # DEC-213: the Voyage REST API
RAG_EMBED_MODEL=voyage-4                        # DEC-213: the embedding model of the entries and of the lookup's fingerprint
RAG_EMBED_DIMS=1024                             # DEC-213: the embedding size, one of 256 / 512 / 1024 / 2048; changing it means `python -m app.rag.vector_index --rebuild`
RAG_RERANK_MODEL=rerank-2.5                     # DEC-213: the rerank model that scores each candidate from 0 to 1
RAG_MIN_SCORE=0.50                              # DEC-213: the lowest rerank score a match may have (provisional, calibrated on the lab KB); 0 <= MIN <= GIONG <= RAT_GIONG <= 1
RAG_LEVEL_GIONG=0.65                            # DEC-213: the score from which a match is `giong` (provisional)
RAG_LEVEL_RAT_GIONG=0.80                        # DEC-213: the score from which a match is `rat_giong` (provisional)
VOYAGE_PRICE_EMBED_PER_M=0.06                   # DEC-213: USD per 1M embedded tokens, counted inside RAG_MONTHLY_USD_CAP
VOYAGE_PRICE_RERANK_PER_M=0.05                  # DEC-213: USD per 1M reranked tokens, counted inside RAG_MONTHLY_USD_CAP
VECTOR_DATABASE_URL=                            # DEC-213: leave empty; docker-compose.rag.yml sets it for the rag-worker service only, from VECTOR_DB_PASSWORD (a secret: it carries that password)
TRIAGE_RAG_FP_BELOW_PCT=0                       # DEC-219: 0..100; the best RAG match below this percentage makes ① answer false_positive (trial: 80); 0 = off
SOAR_NOTICE_API_KEY=                            # SR-T1: the key n8n sends as X-API-Key to POST /webhook/soar-notices, a secret, .env only; empty = that route answers 503 (docs/runbook.md, README "Phản hồi SOAR")
SOAR_NOTICE_IP_ALLOWLIST=                       # SR-T1: JSON list of IPs/CIDRs allowed to post to it, e.g. ["79.79.79.14"]; empty = deny all
N8N_APPROVAL_URL=http://79.79.79.14:5678/webhook/soar-approval   # SR-T1: where the web calls n8n when a person presses a button; the 503 "not configured" needs this and the secret; absent = this default, present and EMPTY (N8N_APPROVAL_URL=) = off
N8N_APPROVAL_SECRET=                            # SR-T1: the X-SOAR-Secret of that call, a secret, .env only; empty = the decision route answers 503 before it locks anything
N8N_APPROVAL_TIMEOUT_SECONDS=45                 # SR-T1: 1..100 (a lock older than two minutes is released by the next press, so a live call must end well before)
SOAR_ROLES_KEEP=tier1,tier2,admin               # SR-T1: roles allowed to press "keep" (comma list of tier1, tier2, admin; anything else stops the start-up)
SOAR_ROLES_UNDO=tier2,admin                     # SR-T1: roles allowed to press "undo"
SOAR_ROLES_FP=tier1,tier2,admin                 # SR-T1: roles allowed to press "false positive"
SOAR_AD_HOSTS=["AD-server"]                     # SR-T1: JSON list of hosts whose tickets get the strong warning: the domain controller; names are normalised (invisible characters, whitespace, a trailing dot, case) and the whole host name or its first DNS label must equal one
# --- END generated from context pack §6.3
#
# SINCE 20/09/2026 the database is the `db` compose service (Owner decision) and
# the three DSNs above take their TCP form — the values to put in .env:
# DATABASE_URL=postgresql://app_rw:<APP_RW_PASSWORD>@127.0.0.1:55432/soc_dev
# DATABASE_URL_OWNER=postgresql://soc:<POSTGRES_PASSWORD>@127.0.0.1:55432/soc_dev
# TEST_DATABASE_URL=postgresql://soc:<POSTGRES_PASSWORD>@127.0.0.1:55432/soc_test
# (host processes reach the container on 127.0.0.1:${DB_PORT}; inside the
# containers docker-compose.yml overrides the first two with db:5432).
# The socket forms in the generated block are the 05–20/09 native cluster,
# kept on IA1803 as a fallback only.
#
# `make test-db` reads TEST_DATABASE_URL from the environment first and from
# this file's real counterpart second. A git worktree has no .env — it is
# git-ignored — so export the variable when working in one.

