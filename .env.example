# --- notifications ---------------------------------------------------------
# SMTP is §6.3's documented alternative to Telegram ("or NOTIFY_SMTP_*").
# To send e-mail instead, strip the "# | " prefix from the six lines below and
# leave the two Telegram keys empty. They stay prefixed rather than plainly
# commented out so the §6.3 completeness check keeps reading them as absent.
# |  NOTIFY_SMTP_HOST=
# |  NOTIFY_SMTP_PORT=
# |  NOTIFY_SMTP_USER=
# |  NOTIFY_SMTP_PASSWORD=
# |  NOTIFY_SMTP_FROM=
# |  NOTIFY_SMTP_TO=

# --- Compose only: NOT part of context pack §6.3 (DEC-003). Read by docker-compose.yml and db/init/*.sh, never by infra/config.py.
POSTGRES_USER=soc
POSTGRES_PASSWORD=
POSTGRES_DB=soc_dev
DB_PORT=55432
APP_RW_PASSWORD=
# VECTOR_DB_PASSWORD (DEC-213): Compose only, like APP_RW_PASSWORD, and a comment here and not a line, so it is not one of the keys counted above and no generator reads it. docker-compose.rag.yml (the trial's override, never merged into main) gives it to the vectordb service as its password and to rag-worker inside VECTOR_DATABASE_URL; `docker compose` refuses to start without it once that file is read. Put it in .env as VECTOR_DB_PASSWORD=<letters and digits only>, since it sits inside a URL.
# INDEXER_HOST_IP: leave unset on IA1803 (host-gateway); on another server the Tailscale IP of IA1803, where the indexer stays
INDEXER_HOST_IP=
