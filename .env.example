# AI Support SOC — configuration template.
#   cp .env.example .env      then fill in the empty values
#
# .env is git-ignored and this repository has a PUBLIC GitHub remote: this file
# carries no real secret and must never carry one.
#
# Everything down to the last block is context pack §6.3, in §6.3's order and
# grouping, with the documented default as the value; secrets are left empty.
# §6.3 is a frozen contract — a new key needs a DECISION_REQUEST in
# docs/plan/INBOX.md, never an edit here.

# --- database · §6.3 since DEC-003 -----------------------------------------
# The application connects as app_rw — a LOGIN role over TCP + scram-sha-256,
# made loginable once per cluster by a superuser (HUONG-DAN §0, DEC-023) —
# and migrations run as the owner role over the passwordless socket (§6.1);
# the grants land with P1 migration 017. The test database name
# must end in _test — backend/tests/conftest.py refuses anything else, so a
# test run can never be pointed at the real database by accident.
# PostgreSQL runs natively on this host and no target needs docker (Owner
# decision, 05/09). These socket DSNs are passwordless: pg_hba gives
# `local all all peer`, while `host 127.0.0.1/32` is scram-sha-256, so a TCP
# form would prompt for a password.
# --- BEGIN generated from context pack §6.3 — edit §6.3, then run scripts/gen_env_example.py
#     Do not add or rename a key here — §6.3 is a frozen contract (DEC-003).
DATABASE_URL=postgresql://app_rw:@127.0.0.1:5432/soc_dev   # app runtime as app_rw (LOGIN, DEC-023); its password goes after the colon, in .env only
DATABASE_URL_OWNER=postgresql:///soc_dev        # migrations and test setup, owner role (user1 owns soc_dev)
TEST_DATABASE_URL=postgresql:///soc_test        # tests only; the database name must end in _test
MAX_PAYLOAD_BYTES=2_097_152
RAW_LOG_MAX_BYTES=1_024_000
PROMPT_LOG_MAX_BYTES=32_768
DEDUP_IDLE_GAP_MINUTES=15
MAX_CLUSTER_AGE_HOURS=4
MAX_CLUSTER_AGE_AUTOCLOSED_MINUTES=30
MAX_CLUSTER_SIZE=1000
INDEXER_URL=https://127.0.0.1:9400
INDEXER_USER=
INDEXER_PASSWORD=
INDEXER_CA=conf/root-ca.pem
INDEXER_INDEX=wazuh-alerts-*
PULL_INTERVAL_S=60
PULL_OVERLAP_S=60
PULL_PAGE=500
PULL_START=2026-08-01
HEARTBEAT_RULE_ID=100999
HEARTBEAT_MAX_AGE_MIN=30
SILENCE_WARN_HOURS=3
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF=[10,60,300]
JOB_LOCK_TIMEOUT_S=300
N_WORKER=1
INVENTORY_PATHS=["conf/inventory.yaml","conf/identities.yaml","conf/iocs.csv"]
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=
LLM_MODEL_PROPOSER=deepseek-v4-flash
LLM_MODEL_VERIFIER=
LLM_TIMEOUT_S=120
LLM_RETRY=2
LLM_MONTHLY_USD_CAP=30
LLM_PRICE_IN_PER_M=0.014
LLM_PRICE_OUT_PER_M=0.66
PROMPT_TOTAL_BUDGET_TOKENS=40_000
CASE_PROMPT_BUDGET_TOKENS=60_000
ANALYZE_QUOTA_PER_USER_DAY=30
NEVER_AUTOCLOSE_AGENTS=[]
AUTOCLOSE_RULE_WIDTH_PCT=30
REVIEW_DELTA_TOLERANCE=20
MAX_ALERTS_PER_CASE=200
JWT_SECRET=
JWT_TTL_HOURS=8
LOGIN_MAX_FAILS=5
LOCKOUT_MINUTES=15
RETENTION_DAYS=365
BACKUP_HOUR=2
EVAL_BLIND_FRACTION=0.5
DISPLAY_TZ=Asia/Ho_Chi_Minh
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# --- END generated from context pack §6.3
#
# Portable alternative for a machine with a working docker daemon, matching
# docker-compose.yml. Nothing in the Makefile depends on it.
# DATABASE_URL=postgresql://soc:soc@127.0.0.1:55432/soc
# DATABASE_URL_OWNER=postgresql://soc:soc@127.0.0.1:55432/soc
# TEST_DATABASE_URL=postgresql://soc:soc@127.0.0.1:55432/soc_test
#
# `make test-db` reads TEST_DATABASE_URL from the environment first and from
# this file's real counterpart second. A git worktree has no .env — it is
# git-ignored — so export the variable when working in one.

