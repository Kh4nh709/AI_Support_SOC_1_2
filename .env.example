# AI Support SOC — configuration template.
#   cp .env.example .env      then fill in the empty values
#
# .env is git-ignored and this repository has a PUBLIC GitHub remote: this file
# carries no real secret and must never carry one.
#
# Everything down to the last block is context pack §6.3, in §6.3's order and
# grouping, with the documented default as the value; secrets are left empty.
# §6.3 is a frozen contract — a new key needs a DECISION_REQUEST in
# docs/plan/INBOX.md, never an edit here.

# --- database · §6.3 since DEC-003 -----------------------------------------
# The application connects as app_rw and migrations run as the owner role
# (§6.1); the role split lands with P1 migration 017. The test database name
# must end in _test — backend/tests/conftest.py refuses anything else, so a
# test run can never be pointed at the real database by accident.
DATABASE_URL=postgresql://soc:soc@127.0.0.1:55432/soc            # app runtime, role app_rw from P1 migration 017
DATABASE_URL_OWNER=postgresql://soc:soc@127.0.0.1:55432/soc      # migrations and test setup, owner role
TEST_DATABASE_URL=postgresql://soc:soc@127.0.0.1:55432/soc_test  # tests only; the database name must end in _test

# --- payload and log size limits -------------------------------------------
MAX_PAYLOAD_BYTES=2_097_152
RAW_LOG_MAX_BYTES=1_024_000
PROMPT_LOG_MAX_BYTES=32_768

# --- dedup / cluster window ------------------------------------------------
DEDUP_IDLE_GAP_MINUTES=15
MAX_CLUSTER_AGE_HOURS=4
MAX_CLUSTER_AGE_AUTOCLOSED_MINUTES=30
MAX_CLUSTER_SIZE=1000

# --- indexer ---------------------------------------------------------------
# DEC-001: on this host the alert store is a plain OpenSearch on :9400.
# wazuh-indexer.service is inactive and disabled and must not be started.
# INDEXER_CA is REQUIRED. TLS is always verified against it; the code offers no
# way to turn verification off and no unverified-TLS switch exists anywhere.
# INDEXER_USER / INDEXER_PASSWORD stay empty until the read-only indexer user
# exists — see docs/plan/INBOX.md, 2026-09-05 · P0 / P2 · BLOCKER.
INDEXER_URL=https://127.0.0.1:9400
INDEXER_USER=
INDEXER_PASSWORD=
INDEXER_CA=conf/root-ca.pem
INDEXER_INDEX=wazuh-alerts-*

# --- puller ----------------------------------------------------------------
PULL_INTERVAL_S=60
PULL_OVERLAP_S=60
PULL_PAGE=500
PULL_START=2026-08-01

# --- heartbeat and silence -------------------------------------------------
HEARTBEAT_RULE_ID=100999
HEARTBEAT_MAX_AGE_MIN=30
SILENCE_WARN_HOURS=3

# --- jobs ------------------------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF=[10,60,300]
JOB_LOCK_TIMEOUT_S=300
N_WORKER=1

# --- inventory files -------------------------------------------------------
INVENTORY_PATHS=["conf/inventory.yaml","conf/identities.yaml","conf/iocs.csv"]

# --- LLM · DeepSeek through the OpenAI-compatible API ----------------------
# LLM_MODEL_VERIFIER empty means "same model as the proposer" (§6.3).
# The model name is provisional; P1-T01 pins it by measurement.
LLM_BASE_URL=https://api.deepseek.com/
LLM_API_KEY=
LLM_MODEL_PROPOSER=deepseek-v4-flash
LLM_MODEL_VERIFIER=
LLM_TIMEOUT_S=120
LLM_RETRY=2

# --- LLM cost · prices are USD per 1M tokens -------------------------------
LLM_MONTHLY_USD_CAP=30
LLM_PRICE_IN_PER_M=0.014
LLM_PRICE_OUT_PER_M=0.66

# --- prompt budgets --------------------------------------------------------
PROMPT_TOTAL_BUDGET_TOKENS=40_000
CASE_PROMPT_BUDGET_TOKENS=60_000
ANALYZE_QUOTA_PER_USER_DAY=30

# --- auto-close and rule review --------------------------------------------
NEVER_AUTOCLOSE_AGENTS=[]
AUTOCLOSE_RULE_WIDTH_PCT=30
REVIEW_DELTA_TOLERANCE=20
MAX_ALERTS_PER_CASE=200

# --- auth ------------------------------------------------------------------
JWT_SECRET=
JWT_TTL_HOURS=8
LOGIN_MAX_FAILS=5
LOCKOUT_MINUTES=15

# --- retention, backup, evaluation, display --------------------------------
RETENTION_DAYS=365
BACKUP_HOUR=2
EVAL_BLIND_FRACTION=0.5
DISPLAY_TZ=Asia/Ho_Chi_Minh

# --- notifications ---------------------------------------------------------
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# SMTP is §6.3's documented alternative to Telegram ("or NOTIFY_SMTP_*").
# To send e-mail instead, strip the "# | " prefix from the six lines below and
# leave the two Telegram keys empty. They stay prefixed rather than plainly
# commented out so the §6.3 completeness check keeps reading them as absent.
# |  NOTIFY_SMTP_HOST=
# |  NOTIFY_SMTP_PORT=
# |  NOTIFY_SMTP_USER=
# |  NOTIFY_SMTP_PASSWORD=
# |  NOTIFY_SMTP_FROM=
# |  NOTIFY_SMTP_TO=

# --- Compose only: NOT part of context pack §6.3 (DEC-003). Read by docker-compose.yml, never by infra/config.py.
POSTGRES_USER=soc
POSTGRES_PASSWORD=soc
POSTGRES_DB=soc
DB_PORT=55432
